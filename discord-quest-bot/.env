# Bot token — the bot that runs the slash commands
DISCORD_BOT_TOKEN=your_bot_token_here

# Guild ID for instant slash-command sync (optional, blank = global)
GUILD_ID=

# Owner user ID(s), comma separated — only these can run commands
OWNER_IDS=123456789012345678

# These get filled in by /token at runtime, but you can pre-seed them
DEFAULT_USER_TOKEN=
DEFAULT_BUILD_NUMBER=504649
